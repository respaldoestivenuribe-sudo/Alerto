{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "railway/dockerfiles/dbt.Dockerfile",
    "watchPatterns": [
      "dbt/**",
      "railway/dbt.json",
      "railway/dockerfiles/dbt.Dockerfile"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
