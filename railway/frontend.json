{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "railway/dockerfiles/frontend.Dockerfile",
    "watchPatterns": [
      "frontend/**",
      "asset/Logo/**",
      "railway/frontend.json",
      "railway/dockerfiles/frontend.Dockerfile"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
